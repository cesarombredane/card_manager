{
  "name": "card_manager_frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static Vue card manager powered by local JSON data.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check .",
    "test": "npm --prefix .. test",
    "test:e2e": "npm --prefix .. run test:e2e",
    "lint:fix": "eslint . --fix",
    "test:watch": "npm --prefix .. run test:watch"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.1",
    "adm-zip": "^0.6.0",
    "jspdf": "^4.2.1",
    "quasar": "^2.20.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.12.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.7",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  }
}
