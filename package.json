{
  "name": "card_manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "build": "npm run build --workspace frontend",
    "update": "node --import tsx update_data.ts",
    "update:images": "node --import tsx scripts/update_tcgdex_images.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace frontend",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "build:fixture": "node --import tsx scripts/fixture_build.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "@types/node": "^22.10.2",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.51.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "globals": "^16.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0"
  }
}
